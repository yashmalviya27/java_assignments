package day01;
//Question:01: Arithmetic Operations
public class question01 {
	public static void main(String[] args) {
		int a = 10;
		int b = 20;
		int addition = a+b;
		int subtraction = b-a;
		int multiplication = a*b;
		int division = b/a;
		int remainder = a%b;
		
//		01: addition
		System.out.println("Addition:"+addition); // Addition:30
//		02: subtraction
		System.out.println("subtraction:"+subtraction); // output: subtraction:10
//		03: multiplication
		System.out.println("multiplication:"+multiplication); // output: multiplication:200
//		04: division
		System.out.println("division:"+division); // output: division:2
//		05: remainder
		System.out.println("remainder:"+remainder); // output: remainder:10
	}
}
